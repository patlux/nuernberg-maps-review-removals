# Copy this file to config.toml for local/private dashboard settings.
# config.toml is ignored by git because it may contain legal contact data.

city = "Nürnberg"
input = "output/places.json"
output = "output/charts/nuernberg_dashboard.html"
site_domain = "nuernberg-maps-review-removals.patwoz.dev"
site_url = "https://nuernberg-maps-review-removals.patwoz.dev"
site_output = "public"

[legal]
# Set to false or remove this section to omit methodik/korrektur/impressum/datenschutz pages.
enabled = true
name = "Patrick Wozniak"
email = "hi@example.com"

address_lines = [
  "c/o Example GmbH",
  "Example Street 1",
  "90443 Nürnberg",
  "Deutschland",
]

note = "Example GmbH ist nicht Betreiberin dieses Angebots. Sie dient ausschließlich als Zustellanschrift."
post_handler = "Example GmbH"

[analytics]
# Disabled by default, including legacy configurations containing only src/domain.
# Enable only after verifying hosting, recipients, retention and transfer safeguards.
# Visitors must additionally opt in before the script is loaded.
enabled = false
privacy_text = ""
src = "https://a.patwoz.dev/js/script.js"
domain = "nuernberg-maps-review-removals.patwoz.dev"

# Required for dashboard/site builds. This publishable key is embedded in HTML.
# Get one at https://carto.com/basemaps/apikey and restrict it to your site domain.
# Store the full config as the GitHub Actions secret DASHBOARD_CONFIG_TOML.
[carto]
# External tiles are disabled by default. The local map still works.
# Enabling requires legal pages and verified provider/transfer information.
enabled = false
privacy_text = ""
api_key = ""

[places_api]
# Optional. Required only for `make scrape ARGS="--places-api-discovery ..."`.
api_key = ""
